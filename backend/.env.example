# CascadeX Backend — Environment Variables
# Copy this file to .env and fill in the values.
# .env is git-ignored; .env.example is committed with placeholder values only.

# ─────────────────────────────────────────────
# Neo4j connection
# ─────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_in_production

# ─────────────────────────────────────────────
# JWT auth
# ─────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_in_production_use_a_long_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─────────────────────────────────────────────
# Application environment
# ─────────────────────────────────────────────
# One of: dev | test | staging | production
ENV=dev

# ─────────────────────────────────────────────
# CORS — comma-separated allowed origins
# ─────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ─────────────────────────────────────────────
# AI/LLM — Gemini API (Phase 09)
# ─────────────────────────────────────────────
# Leave empty to run in stub mode (difflib fallback, no network calls).
# Get a key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Maximum candidate drugs passed to the LLM for fuzzy name matching
OCR_MATCH_TOP_K=20

# ─────────────────────────────────────────────
# Field-level encryption (Phase 09)
# ─────────────────────────────────────────────
# Fernet symmetric key for encrypting sensitive Neo4j properties (e.g. raw OCR text).
# Leave empty to disable encryption in dev (passthrough mode — NEVER leave empty in production).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
